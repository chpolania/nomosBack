{
  "name": "mati-arqsw-nodejs-api-mngr",
  "version": "1.0.0",
  "description": "nodejs api that handles availability tactics for ASR on the 2nd challenge",
  "keywords": [
    "nodejs",
    "availability",
    "security",
    "template",
    "ASR tactics",
    "backend"
  ],
  "author": "@AndresFWilT",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc",
    "build:dev": "tsc",
    "build:lab": "tsc",
    "build:prod": "tsc",
    "start": "node ./build/src/bin/www.js",
    "start:dev": "npm run build && export DEBUG=mati-arqsw:* && npm start",
    "dev": "nodemon --watch src -e ts,js --exec npm run start:dev",
    "test:file": "export $(cat test/.env-test | xargs) && mocha --timeout 10000 --require ts-node/register",
    "test:only": "npm run test:file -- 'test/*/.spec.ts'",
    "test": "npm run lint && npm run test:only",
    "coverage": "export $(cat test/.env-test | xargs) && nyc _mocha --timeout 10000 --require ts-node/register 'test/*/.spec.ts'",
    "coverage:report": "nyc report --reporter=lcov --reporter=text",
    "coverage:web": "npm run coverage && serve coverage/",
    "lint": "tslint -c tslint.json -p tsconfig.json",
    "lint:fix": "npm run lint -- --fix",
    "debug": "DEBUG=* node ./build/src/bin/www.js",
    "clean": "rm -rf .nyc_output coverage build .scannerwork performance/.clinic-doctor",
    "seed": "ts-node ./src/infrastructure/db/seed.ts"
  },
  "dependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/debug": "^4.1.12",
    "@types/express": "^4.17.21",
    "@types/express-actuator": "^1.8.3",
    "@types/morgan": "^1.9.9",
    "axios": "^1.6.7",
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.2",
    "cookie-parser": "^1.4.6",
    "debug": "^4.3.4",
    "dotenv": "^18.0.8",
    "express": "^4.18.3",
    "express-actuator": "^1.8.4",
    "express-openapi-validator": "^5.1.6",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "mysql2": "^3.24.6",
    "nodemon": "^3.1.0",
    "typescript": "^5.3.3",
    "uuid": "^14.0.3",
    "uuidv4": "^6.2.13"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "ts-node": "^10.9.2"
  }
}
